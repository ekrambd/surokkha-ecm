rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products Collection (Public read, Admin write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /ecom_products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Coupons Collection (Public can read coupons; Admin can write)
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(couponId);
    }

    // Book Orders Collection (Public customers can place orders and look up order by ID; Admins can list and write)
    match /book_orders/{orderId} {
      allow get: if true;
      allow create: if isValidId(orderId);
      allow list, update, delete: if isSignedIn();
    }

    // Customers Collection (Public create upon order, admin list & manage)
    match /customers/{customerId} {
      allow create: if isValidId(customerId);
      allow read, write: if isSignedIn() && isValidId(customerId);
    }
    match /ecom_customers/{customerId} {
      allow create: if isValidId(customerId);
      allow read, write: if isSignedIn() && isValidId(customerId);
    }

    // Students Collection
    match /students/{studentId} {
      allow get: if true; // Public lookup for verification
      allow list: if isSignedIn(); // Admin only list
      allow write: if isSignedIn() && isValidId(studentId);
    }

    // Registrations Collection
    match /registrations/{registrationId} {
      allow read, write: if isSignedIn() && isValidId(registrationId);
    }

    // Certificates Collection
    match /certificates/{certificateId} {
      allow get: if true; // Public verification allows looking up single certificate by ID
      allow list: if isSignedIn(); // Admin can view complete index
      allow write: if isSignedIn() && isValidId(certificateId);
    }

    // Student Groups & Sessions
    match /student_groups/{groupId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(groupId);
    }

    match /student_sessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(sessionId);
    }

    // Public settings may be read by the storefront; only authenticated admins may change them.
    // Block legacy e-commerce documents from public reads until old secrets are purged.
    match /settings/{settingId} {
      allow read: if isSignedIn()
        || (isValidId(settingId)
          && (settingId != 'ecom_settings'
            || !resource.data.keys().hasAny(['metaApiToken', 'steadfastApiKey', 'steadfastSecretKey'])));
      allow write: if isSignedIn() && isValidId(settingId);
    }

    // User-specific document subtree (users/{userId}/...)
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
