{
  "name": "zinniamart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:cluster": "tsx src/server/clusterServer.ts",
    "start:cluster": "node dist/clusterServer.cjs",
    "backup:create": "node --import tsx scripts/disasterRecovery.ts create",
    "backup:list": "node --import tsx scripts/disasterRecovery.ts list",
    "backup:restore": "node --import tsx scripts/disasterRecovery.ts restore",
    "build": "node scripts/generate-sitemap.cjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/server/clusterServer.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/clusterServer.cjs",
    "start": "node dist/server.cjs",
    "postinstall": "prisma generate",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integrations": "node --import tsx scripts/integrationSmokeTest.ts",
    "test:storefront": "node --import tsx scripts/storefrontSmokeTest.ts",
    "test:sqa": "npm run lint && npm run typecheck && npm run test && npm run test:storefront && npm run test:integrations && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "sharp": "^0.35.5",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
